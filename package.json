{
  "name": "infer-dos",
  "version": "0.0.4",
  "description": "a helper tool to infer the Durable Objects of a given file",
  "homepage": "https://github.com/threepointone/infer-dos",
  "repository": {
    "type": "git",
    "url": "https://github.com/threepointone/infer-dos.git"
  },
  "bin": {
    "infer-dos": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.js"
    }
  },
  "scripts": {
    "check": "biome check && tsc && vitest --watch false",
    "build": "npx tsup src --format esm --dts"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "durable-objects",
    "typescript",
    "cloudflare"
  ],
  "author": "Sunil Pai <spai@cloudflare.com>",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@cloudflare/actors": "^0.0.1-beta.0",
    "@cloudflare/vite-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^4.20250705.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "agents": "^0.0.101",
    "partyserver": "^0.0.72",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vite": "^7.0.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.23.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
